-- Lógica de Redirecionamento de Tiro (Silent Aim)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if Settings.Silent_Enabled and (method == "FindPartOnRayWithIgnoreList" or method == "Raycast") then
        if math.random(1, 100) <= (100 - Settings.Silent_Chance) then return oldNamecall(self, ...) end
        local target = GetClosestPlayerToMouse()
        if target and target.Character then
            local hitPart = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if hitPart then
                if Settings.Silent_MagicBullets then
                    -- Lógica de Magic Bullets (Redireciona o tiro diretamente)
                    return hitPart, hitPart.Position, Vector3.new(0,0,0), hitPart.Material
                end
            end
        end
    end
    return oldNamecall(self, ...)
end)

