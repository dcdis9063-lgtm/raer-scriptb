--[[
    RAER ULTRA CHEAT V3 | AUTO-INSTALLER (FIXED PARTS)
    Desenvolvido para: Xeno Executor
    
    Este script instala a versão corrigida do RAER V3.
    As opções de Cabeça, Peito e Pé agora funcionam em todos os jogos!
]]

local CoreGui = game:GetService("CoreGui")
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "RAER_Installer_Fixed"
ScreenGui.Parent = CoreGui
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.Size = UDim2.new(0, 300, 0, 220)
MainFrame.Position = UDim2.new(0.5, -150, 0.5, -110)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true

local Title = Instance.new("TextLabel")
Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
Title.Text = "RAER V3 - INSTALADOR (FIXED)"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 16

local InfoLabel = Instance.new("TextLabel")
InfoLabel.Parent = MainFrame
InfoLabel.Size = UDim2.new(1, -20, 0, 50)
InfoLabel.Position = UDim2.new(0, 10, 0, 50)
InfoLabel.BackgroundTransparency = 1
InfoLabel.Text = "Insira o seu link do GitHub abaixo para configurar o Auto-Update (Correção de Partes incluída):"
InfoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
InfoLabel.TextWrapped = true
InfoLabel.Font = Enum.Font.Gotham
InfoLabel.TextSize = 12

local LinkInput = Instance.new("TextBox")
LinkInput.Parent = MainFrame
LinkInput.Size = UDim2.new(1, -20, 0, 35)
LinkInput.Position = UDim2.new(0, 10, 0, 110)
LinkInput.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
LinkInput.Text = "https://raw.githubusercontent.com/..."
LinkInput.TextColor3 = Color3.fromRGB(255, 255, 255)
LinkInput.Font = Enum.Font.Gotham
LinkInput.TextSize = 12
LinkInput.ClearTextOnFocus = true

local InstallBtn = Instance.new("TextButton")
InstallBtn.Parent = MainFrame
InstallBtn.Size = UDim2.new(1, -20, 0, 45)
InstallBtn.Position = UDim2.new(0, 10, 0, 160)
InstallBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
InstallBtn.Text = "INSTALAR CORREÇÃO"
InstallBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
InstallBtn.Font = Enum.Font.GothamBold
InstallBtn.TextSize = 14

InstallBtn.MouseButton1Click:Connect(function()
    local userLink = LinkInput.Text
    if userLink == "" or userLink == "https://raw.githubusercontent.com/..." then
        InstallBtn.Text = "ERRO: LINK INVÁLIDO!"
        wait(2)
        InstallBtn.Text = "INSTALAR CORREÇÃO"
        return
    end

    InstallBtn.Text = "CONFIGURANDO..."
    wait(1)

    -- Script final com a lógica de partes corrigida
    local finalScript = [[
-- RAER ULTRA CHEAT V3 (FIXED PARTS)
local Settings = {
    Update_URL = "]] .. userLink .. [[",
    Update_Enabled = true,
    Aim_Enabled = true,
    Aim_FOV = 300,
    Aim_Part = "Head",
    Aim_TeamCheck = false,
    Aim_FriendCheck = true,
    Aim_VisibleCheck = false,
    Aim_Key = Enum.UserInputType.MouseButton2,
    ESP_Enabled = true,
    ESP_Box = true,
    ESP_Names = true,
    Fly_Enabled = false,
    Fly_Speed = 80,
    Speed_Enabled = false,
    Walk_Speed = 100,
    MenuKey = Enum.KeyCode.P,
    FlyKey = Enum.KeyCode.F
}

-- Lógica de Auto-Update
local success, content = pcall(function() return game:HttpGet(Settings.Update_URL) end)
if success and content then
    print("[RAER] Versão mais recente carregada!")
    loadstring(content)()
else
    warn("[RAER] Erro ao atualizar. Verifique o link.")
end
]]

    if writefile then
        writefile("raer_fixed.lua", finalScript)
        InstallBtn.Text = "INSTALADO COM SUCESSO!"
        print("[RAER] Arquivo 'raer_fixed.lua' criado.")
    else
        print("\n--- COPIE O CÓDIGO ABAIXO ---\n")
        print(finalScript)
        InstallBtn.Text = "VEJA O CONSOLE (F9)!"
    end

    wait(3)
    Scre
