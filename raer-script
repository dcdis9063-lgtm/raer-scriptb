end)

-- Função auxiliar para encontrar o jogador mais próximo (reutilizada do script anterior)
local function GetClosestPlayer(fov, maxDist, visibleOnly, ignoreNPCs)
    local target = nil
    local shortestDistance = fov
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if ignoreNPCs and not player:IsA("Player") then continue end
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local targetPart = player.Character:FindFirstChild("Head") -- Silent Aim foca na cabeça por padrão
            if targetPart then
                local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local distToPlayer = (Camera.CFrame.Position - targetPart.Position).Magnitude
                    if distToPlayer > maxDist then continue end
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y + 36)).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        target = targetPart
                    end
                end
            end
        end
    end
    return target
end

