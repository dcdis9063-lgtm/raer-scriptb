-- ================================================
-- LÓGICA DO SILENT AIM
-- ================================================
local function GetClosestPlayerToMouse()
    local target = nil
    local shortestDistance = Settings.Silent_FOV
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Settings.Silent_IgnoreNPCs and not player:IsA("Player") then continue end
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local root = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Head")
            if root then
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local distToPlayer = (Camera.CFrame.Position - root.Position).Magnitude
                    if distToPlayer > Settings.Silent_MaxDist then continue end
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y + 36)).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        target = player
                    end
                end
            end
        end
    end
    return target
end

