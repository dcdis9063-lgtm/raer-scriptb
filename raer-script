--[[
    RAER ULTIMATE CHEAT | V5 DEFINITIVE FIX (Silent Aim Ultra-Compatible)
    Design: SKECH V2 (Dark/Red) - Premium
    Compatibilidade: Xeno Executor (R6 & R15)
    
    Esta versão é otimizada para máxima compatibilidade com executores como o Xeno.
    A interface gráfica foi removida para evitar conflitos com o CoreGui e Drawing.new.
    O Silent Aim é ativado/desativado por uma tecla e as configurações são pré-definidas.
]]

-- ================================================
-- VARIÁVEIS GLOBAIS (CONFIGURAÇÕES BÁSICAS)
-- ================================================
getgenv().RAER_Settings = {
    Silent_Enabled = false,
    Silent_Key = Enum.UserInputType.MouseButton2, -- Botão Direito do Mouse
    Silent_FOV = 20,
    Silent_HitChance = 100, -- 100% de chance de acerto
    Silent_MaxDist = 203,
    Silent_VisibleOnly = false,
    Silent_IgnoreNPCs = false,
    MenuKey = Enum.KeyCode.P -- Tecla para alternar o Silent Aim (sem GUI)
}

local Settings = getgenv().RAER_Settings

-- ================================================
-- VARIÁVEIS DE SISTEMA
-- ================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- ================================================
-- LÓGICA DO SILENT AIM
-- ================================================

local function GetClosestPlayer(fov, maxDist, visibleOnly, ignoreNPCs)
    local target = nil
    local shortestDistance = fov
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if ignoreNPCs and not player:IsA("Player") then continue end
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local targetPart = player.Character:FindFirstChild("Head") -- Silent Aim foca na cabeça por padrão
            if targetPart then
                local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local distToPlayer = (Camera.CFrame.Position - targetPart.Position).Magnitude
                    if distToPlayer > maxDist then continue end
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y + 36)).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        target = targetPart
                    end
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    if Settings.Silent_Enabled and UserInputService:IsMouseButtonPressed(Settings.Silent_Key) then
        if math.random(1, 100) <= Settings.Silent_HitChance then
            local target = GetClosestPlayer(Settings.Silent_FOV, Settings.Silent_MaxDist, Settings.Silent_VisibleOnly, Settings.Silent_IgnoreNPCs)
            if target then
                -- Implementação básica de Silent Aim: Redireciona o mouse para o alvo
                -- Esta é uma simulação que pode funcionar em alguns contextos.
                local pos, onScreen = Camera:WorldToViewportPoint(target.Position)
                if onScreen then
                    Mouse.X = pos.X
                    Mouse.Y = pos.Y
                end
            end
        end
    end
end)

-- Lógica para alternar o Silent Aim com a tecla MenuKey (sem GUI)
UserInputService.InputBegan:Connect(function(input, processed)
    if input.KeyCode == Settings.MenuKey and not processed then
        Settings.Silent_Enabled = not Settings.Silent_Enabled
        print("[RAER V5 SILENT ULTRA-COMPATIBLE] Silent Aim: " .. tostring(Settings.Silent_Enabled))
    end
end)

print("[RAER V5 SILENT ULTRA-COMPATIBLE] Carregado com sucesso! Pressione 'P' para alternar o Silent Aim.")


