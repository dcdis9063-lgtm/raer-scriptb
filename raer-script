-- Função para criar um botão de aba
local function createTabButton(name)
    local TabButton = Instance.new("TextButton")
    TabButton.Parent = TabsFrame
    TabButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabButton.Font = Enum.Font.SourceSans
    TabButton.TextSize = 16
    TabButton.Text = name
    TabButton.Size = UDim2.new(1, -10, 0, 30) -- -10 para ter um pequeno padding lateral
    TabButton.AutoButtonColor = false
    TabButton.BorderColor3 = Color3.fromRGB(20, 20, 20)
    TabButton.BorderSizePixel = 1

    -- Frame de conteúdo para esta aba
    local ContentPage = Instance.new("Frame")
    ContentPage.Parent = ContentFrame
    ContentPage.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    ContentPage.Size = UDim2.new(1, 0, 1, 0)
    ContentPage.Position = UDim2.new(0, 0, 0, 0)
    ContentPage.Visible = false -- Esconde por padrão
    tabContents[name] = ContentPage

    TabButton.MouseButton1Click:Connect(function()
        if currentTab then
            tabContents[currentTab].Visible = false
            -- Resetar cor do botão da aba anterior
            TabsFrame[currentTab .. "TabButton"].BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            TabsFrame[currentTab .. "TabButton"].BorderColor3 = Color3.fromRGB(20, 20, 20)
        end
        ContentPage.Visible = true
        currentTab = name
        -- Destacar o botão da aba atual
        TabButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        TabButton.BorderColor3 = Color3.fromRGB(255, 0, 0)
    end)

    TabButton.Name = name .. "TabButton" -- Nome para fácil acesso
    return TabButton, ContentPage
end

-- Função auxiliar para criar um toggle button
local function createToggle(parent, text, defaultState, callback)
    local toggleButton = Instance.new("TextButton")
    toggleButton.Parent = parent
    toggleButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.Font = Enum.Font.SourceSans
    toggleButton.TextSize = 16
    toggleButton.Size = UDim2.new(0.9, 0, 0, 30)
    toggleButton.AutoButtonColor = false

    local enabled = defaultState
    local function updateText()
        toggleButton.Text = text .. ": " .. (enabled and "Ativado" or "Desativado")
        if enabled then
            toggleButton.BackgroundColor3 = Color3.fromRGB(0, 150, 0) -- Verde quando ativado
        else
            toggleButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70) -- Cinza quando desativado
        end
    end

    updateText()

    toggleButton.MouseButton1Click:Connect(function()
        enabled = not enabled
        updateText()
        if callback then
            callback(enabled)
        end
    end)
    return toggleButton, function() return enabled end -- Retorna o botão e uma função para obter o estado
end

-- Função auxiliar para criar um slider
local function createSlider(parent, labelText, minValue, maxValue, defaultValue, callback)
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Parent = parent
    sliderFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    sliderFrame.Size = UDim2.new(0.9, 0, 0, 30)

    local sliderLabel = Instance.new("TextLabel")
    sliderLabel.Parent = sliderFrame
    sliderLabel.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    sliderLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    sliderLabel.Font = Enum.Font.SourceSans
    sliderLabel.TextSize = 14
    sliderLabel.Text = labelText .. ": " .. tostring(defaultValue)
    sliderLabel.Size = UDim2.new(0.5, 0, 1, 0)
    sliderLabel.TextXAlignment = Enum.TextXAlignment.Left

    local sliderBar = Instance.new("Frame") -- A barra do slider
    sliderBar.Parent = sliderFrame
    sliderBar.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    sliderBar.Size = UDim2.new(0.4, 0, 0.8, 0)
    sliderBar.Position = UDim2.new(0.5, 0, 0.1, 0)

    local sliderHandle = Instance.new("Frame") -- O "pino" do slider
    sliderHandle.Parent = sliderBar
    sliderHandle.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    sliderHandle.Size = UDim2.new(0, 10, 1, 0)
    
    local currentValue = defaultValue

    local function updateSliderPosition(value)
        local percentage = (value - minValue) / (maxValue - minValue)
        sliderHandle.Position = UDim2.new(percentage, -sliderHandle.Size.X.Offset / 2, 0, 0)
        sliderLabel.Text = labelText .. ": " .. tostring(math.floor(value))
    end

    updateSliderPosition(defaultValue)

    local function onInputChanged(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local mouseX = input.Position.X - sliderBar.AbsolutePosition.X
            local percentage = math.clamp(mouseX / sliderBar.AbsoluteSize.X, 0, 1)
            currentValue = minValue + (maxValue - minValue) * percentage
            updateSliderPosition(currentValue)
            if callback then
                callback(math.floor(currentValue))
            end
        end
    end

    sliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local connection
            connection = game:GetService("UserInputService").InputChanged:Connect(function(inputChanged)
                onInputChanged(inputChanged)
            end)
            game:GetService("UserInputService").InputEnded:Connect(function(inputEnded)
                if inputEnded.UserInputType == Enum.UserInputType.MouseButton1 then
                    connection:Disconnect()
                end
            end)
        end
    end)

    return sliderFrame, function() return math.floor(currentValue) end -- Retorna o frame e uma função para obter o valor
end

