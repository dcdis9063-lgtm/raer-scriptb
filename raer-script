-- Dicionário para armazenar os frames de conteúdo de cada aba
local tabContents = {}
local currentTab = nil

-- Função para criar um botão de aba
local function createTabButton(name)
    local TabButton = Instance.new("TextButton")
    TabButton.Parent = TabsFrame
    TabButton.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabButton.Font = Enum.Font.SourceSans
    TabButton.TextSize = 16
    TabButton.Text = name
    TabButton.Size = UDim2.new(1, -10, 0, 30) -- -10 para ter um pequeno padding lateral
    TabButton.AutoButtonColor = false
    TabButton.BorderColor3 = Color3.fromRGB(20, 20, 20)
    TabButton.BorderSizePixel = 1

    -- Frame de conteúdo para esta aba
    local ContentPage = Instance.new("Frame")
    ContentPage.Parent = ContentFrame
    ContentPage.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    ContentPage.Size = UDim2.new(1, 0, 1, 0)
    ContentPage.Position = UDim2.new(0, 0, 0, 0)
    ContentPage.Visible = false -- Esconde por padrão
    tabContents[name] = ContentPage

    TabButton.MouseButton1Click:Connect(function()
        if currentTab then
            tabContents[currentTab].Visible = false
            -- Resetar cor do botão da aba anterior
            TabsFrame[currentTab .. "TabButton"].BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            TabsFrame[currentTab .. "TabButton"].BorderColor3 = Color3.fromRGB(20, 20, 20)
        end
        ContentPage.Visible = true
        currentTab = name
        -- Destacar o botão da aba atual
        TabButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        TabButton.BorderColor3 = Color3.fromRGB(255, 0, 0)
    end)

    TabButton.Name = name .. "TabButton" -- Nome para fácil acesso
    return TabButton, ContentPage
end

