--[[
    RAER ULTIMATE CHEAT | V5 DEFINITIVE FIX (Silent Aim Raw Script)
    Design: SKECH V2 (Dark/Red) - Premium
    Compatibilidade: Xeno Executor (R6 & R15)
    
    Esta é uma versão 'Raw Script' para máxima compatibilidade com o Xeno.
    Não possui interface gráfica. O Silent Aim é ativado/desativado por uma tecla.
    As configurações são fixas e a lógica é a mais simples possível para evitar falhas.
]]

-- ================================================
-- VARIÁVEIS DE CONFIGURAÇÃO (FIXAS)
-- ================================================
local SILENT_AIM_ENABLED = false
local SILENT_AIM_KEY = Enum.UserInputType.MouseButton2 -- Botão Direito do Mouse
local SILENT_AIM_TOGGLE_KEY = Enum.KeyCode.P -- Tecla para ativar/desativar (sem GUI)
local SILENT_AIM_FOV = 20
local SILENT_AIM_MAX_DIST = 203
local SILENT_AIM_VISIBLE_ONLY = false
local SILENT_AIM_IGNORE_NPCS = false
local SILENT_AIM_HIT_CHANCE = 100 -- 100% de chance de acerto

-- ================================================
-- VARIÁVEIS DE SISTEMA
-- ================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- ================================================
-- FUNÇÃO AUXILIAR: ENCONTRAR JOGADOR MAIS PRÓXIMO
-- ================================================
local function GetClosestPlayer(fov, maxDist, visibleOnly, ignoreNPCs)
    local target = nil
    local shortestDistance = fov
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if ignoreNPCs and not player:IsA("Player") then continue end
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local targetPart = player.Character:FindFirstChild("Head") -- Foca na cabeça por padrão
            if targetPart then
                local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local distToPlayer = (Camera.CFrame.Position - targetPart.Position).Magnitude
                    if distToPlayer > maxDist then continue end
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y + 36)).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        target = targetPart
                    end
                end
            end
        end
    end
    return target
end

-- ================================================
-- LÓGICA PRINCIPAL DO SILENT AIM (AIM ASSIST)
-- ================================================
RunService.RenderStepped:Connect(function()
    if SILENT_AIM_ENABLED and UserInputService:IsMouseButtonPressed(SILENT_AIM_KEY) then
        if math.random(1, 100) <= SILENT_AIM_HIT_CHANCE then
            local target = GetClosestPlayer(SILENT_AIM_FOV, SILENT_AIM_MAX_DIST, SILENT_AIM_VISIBLE_ONLY, SILENT_AIM_IGNORE_NPCS)
            if target then
                -- Redireciona o mouse para o alvo
                local pos, onScreen = Camera:WorldToViewportPoint(target.Position)
                if onScreen then
                    Mouse.X = pos.X
                    Mouse.Y = pos.Y
                end
            end
        end
    end
end)

-- ================================================
-- LÓGICA DE ATIVAÇÃO/DESATIVAÇÃO POR TECLA
-- ================================================
UserInputService.InputBegan:Connect(function(input, processed)
    if input.KeyCode == SILENT_AIM_TOGGLE_KEY and not processed then
        SILENT_AIM_ENABLED = not SILENT_AIM_ENABLED
        print("[RAER V5 SILENT RAW SCRIPT] Silent Aim: " .. tostring(SILENT_AIM_ENABLED))
    end
end)

print("[RAER V5 SILENT RAW SCRIPT] Carregado com sucesso! Pressione 'P' para alternar o Silent Aim.")
