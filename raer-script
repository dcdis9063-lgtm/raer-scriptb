    btn.MouseButton1Click:Connect(function()
        currentIdx = currentIdx + 1
        if currentIdx > #options then currentIdx = 1 end
        Settings[settingKey] = options[currentIdx]
        btn.Text = options[currentIdx]
    end)
end

